# Masukkan Private Key wallet Anda (tanpa 0x atau dengan 0x)
# Anda bisa memasukkan 1 key atau dipisahkan koma untuk multi-wallet
PRIVATE_KEYS=your_private_key_here

# RPC Base Sepolia (default: https://sepolia.base.org)
RPC_URL=https://sepolia.base.org

# Referrer address (opsional - alamat referral nilly untuk dapat bonus points/fee)
REFERRER_ADDRESS=0x0000000000000000000000000000000000000000

# Jumlah ETH per trade (default 0.0001 ETH, minimal sesuai aturan Nilly adalah 0.0001 ETH)
TRADE_AMOUNT_ETH=0.0001
